{
  "name": "novada-auth-dashboard-integrated",
  "version": "1.1.4",
  "description": "Integrated Novada authentication + dashboard full-stack starter",
  "main": "backend/server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node backend/server.js",
    "dev": "cross-env NODE_ENV=development nodemon backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev -- --host",
    "build:frontend": "npm --prefix frontend run build",
    "preview:frontend": "npm --prefix frontend run preview",
    "test": "jest --runInBand --passWithNoTests",
    "lint": "eslint \"backend/**/*.js\" \"auth-pages/js/**/*.js\""
  },
  "keywords": [
    "authentication",
    "login",
    "register",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.5",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
